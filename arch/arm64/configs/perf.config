# Custom Nightly Overclocks
CONFIG_NIGHTLY_OC_GPU=y
CONFIG_NIGHTLY_OC_CCI=y
# CONFIG_NIGHTLY_UV is not set

# Aggressive CPU Governor
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL is not set

# Maximum UI Responsiveness (1000Hz tick)
CONFIG_HZ_1000=y
# CONFIG_HZ_300 is not set
# CONFIG_HZ_100 is not set
CONFIG_HZ=1000

# Fast frequency scaling (8ms half-life ramps up clocks instantly)
CONFIG_PELT_UTIL_HALFLIFE_8=y
# CONFIG_PELT_UTIL_HALFLIFE_16 is not set

# BORE Scheduler for UI fluidity under load
CONFIG_SCHED_BORE=y

# Low-latency I/O (flash storage doesn't need complex sorting)
CONFIG_DEFAULT_IOSCHED="deadline"
CONFIG_DEFAULT_DEADLINE=y
# CONFIG_DEFAULT_BFQ is not set
